PUBLIC_BASE_URL=https://photos.yourdomain.com
ADMIN_TOKEN=replace-with-a-long-random-secret
DATA_DIR=./data
MATCH_THRESHOLD=0.42

# Compact low-memory face model settings
FACE_MODEL=buffalo_sc
FACE_MODEL_ROOT=~/.insightface
FACE_DET_SIZE=320
FACE_MAX_IMAGE_DIM=2000

# Keep CPU libraries from creating excess worker threads
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
MALLOC_ARENA_MAX=2

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PHOTOGRAPHER_EMAIL=
